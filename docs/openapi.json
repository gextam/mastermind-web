                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Game already finished",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guess": {
                    "type": [
                      "string",
                      "array"
                    ],
                    "items": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "description": "A code: an array of colour names, letters or numbers ([\"red\",\"green\",\"blue\",\"yellow\"], [\"R\",\"G\",\"B\",\"Y\"], [1,4,5,3]) or a string of letters/digits (\"RGBY\", \"1453\"). Letters: R red, O orange, Y yellow, G green, B blue, P purple, W white, K black, C cyan, N pink; \".\" is empty when blanks are allowed."
                  }
                },
                "required": [
                  "guess"
                ]
              }
            }
          }
        }
      }
    },
